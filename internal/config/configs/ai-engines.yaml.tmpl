# ai/engines.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# AI engine configuration for OpenAI-compatible API.

engines:
  - name: {{ .AIEngineName | default "default" | quote }}
    type: openai
    base_url: {{ .AIBaseURL | quote }}
    api_key: LOOKUP[vault,/secrets/data/{{ .ProjectName }}/openaiApiKey]
    model: {{ .AIModel | quote }}
    max_tokens: 4096
    temperature: 0.3
    timeout_seconds: 30
