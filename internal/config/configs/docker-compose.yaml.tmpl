# docker-compose.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# Docker Compose configuration for Honeydipper.
#
# NOTE: Before running `docker compose up`, ensure the required environment
# variables are set in your shell or in a .env file.
{{- if eq .BootstrapCloneCredentialType "pat" }}
#   DIPPER_GIT_PASS=your_personal_access_token
{{- else if eq .BootstrapCloneCredentialType "github_app" }}
#   GH_APP_ID=your_app_id
#   GH_APP_INSTALLATION_ID=your_installation_id
#   GH_APP_KEY=your_private_key_content
{{- end }}

version: "3.8"

services:
  honeydipper:
    image: honeydipper/honeydipper:{{ .DockerImageTag | quote }}
    container_name: {{ .ProjectName }}-honeydipper
    restart: unless-stopped
    ports:
      - "{{ .DockerAPIPort }}:9000"
      - "{{ .DockerWebhookPort }}:8080"
    volumes:
      - ./configs:/etc/honeydipper/config
    environment:
      - HONEYDIPPER_UI_ENABLED={{ .DockerEnableUI }}
{{- if eq .BootstrapCloneCredentialType "pat" }}
      - DIPPER_GIT_PASS=${DIPPER_GIT_PASS}
{{- else if eq .BootstrapCloneCredentialType "github_app" }}
      - GH_APP_ID=${GH_APP_ID}
      - GH_APP_INSTALLATION_ID=${GH_APP_INSTALLATION_ID}
      - GH_APP_KEY=${GH_APP_KEY}
{{- end }}
    depends_on:
      - redis
    networks:
      - honeydipper-net

  redis:
    image: redis:7-alpine
    container_name: {{ .ProjectName }}-redis
    restart: unless-stopped
    volumes:
      - redis-data:/data
    networks:
      - honeydipper-net

{{- if eq .DeploymentMode "docker" }}
{{- if ne .RedisMode "local" }}
  # External Redis - uncomment if using external Redis
  # redis:
  #   image: redis:7-alpine
  #   container_name: {{ .ProjectName }}-redis
{{- end }}
{{- end }}

volumes:
  redis-data:

networks:
  honeydipper-net:
    driver: bridge
