# docker-compose.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# Docker Compose configuration for Honeydipper.
#
# NOTE: Before running `docker compose up`, ensure the required environment
# variables are set in your shell or in a .env file.
{{- if eq .BootstrapCloneCredentialType "pat" }}
#   DIPPER_GIT_PAT=your_personal_access_token
{{- else if eq .BootstrapCloneCredentialType "github_app" }}
#   GH_APP_ID=your_app_id
#   GH_APP_INSTALLATION_ID=your_installation_id
#   GH_APP_KEY=your_private_key_content
{{- end }}

version: "3.8"

services:
  honeydipper:
    image: honeydipper/honeydipper:{{ .DockerImageTag }}
    container_name: {{ .ProjectName }}-honeydipper
    restart: unless-stopped
    ports:
      - "{{ .DockerAPIPort }}:9000"
      - "{{ .DockerWebhookPort }}:8080"
    environment:
      - REPO={{ if .GithubCreateRepo }}{{ if .UseLocalCopy }}/etc/honeydipper/config{{ else }}{{ if .GitRemoteURL }}{{ .GitRemoteURL }}{{ else }}/etc/honeydipper/config{{ end }}{{ end }}{{ else }}/etc/honeydipper/config{{ end }}
{{- if .ConfigRepoCloneEnvVars }}
{{- range $key, $value := .ConfigRepoCloneEnvVars }}
      - {{ $key }}={{ $value }}
{{- end }}
{{- end }}
{{- if eq .BootstrapCloneCredentialType "pat" }}
      - DIPPER_GIT_PAT=${DIPPER_GIT_PAT}
{{- else if eq .BootstrapCloneCredentialType "github_app" }}
      - GH_APP_ID=${GH_APP_ID}
      - GH_APP_INSTALLATION_ID=${GH_APP_INSTALLATION_ID}
      - GH_APP_KEY=${GH_APP_KEY}
{{- end }}
{{- if eq .SecretsBackend "dev" }}
{{- range .DevEnvVars }}
      - {{ printf "%s=${%s}" . . }}
{{- end }}
{{- end }}
{{- if or (not .GithubCreateRepo) .UseLocalCopy }}
    volumes:
      - {{ .ConfigDirAbs }}:/etc/honeydipper/config
{{- end }}
{{- if .ConfigRepoSSHKeyFile }}
      - {{ .ConfigRepoSSHKeyFile }}:{{ .ConfigRepoSSHKeyFile }}:ro
{{- end }}
{{- if eq .RedisMode "local" }}
    depends_on:
      - redis
{{- end }}
    networks:
      - honeydipper-net

{{- if eq .RedisMode "local" }}
  redis:
    image: redis:7-alpine
    container_name: {{ .ProjectName }}-redis
    restart: unless-stopped
    volumes:
      - redis-data:/data
    networks:
      - honeydipper-net

volumes:
  redis-data:
{{- end }}

networks:
  honeydipper-net:
    driver: bridge
