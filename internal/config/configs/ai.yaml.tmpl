# ai/basic.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# AI agent definition for natural language workflow triggers.

agents:
  - name: {{ .AIEngineName | quote }}
    type: openai
    model: {{ .AIModel | quote }}
    system_prompt: |
      You are a Honeydipper AI assistant. You help users create and manage
      workflows, triggers, and actions. Respond with valid YAML when asked
      to create or modify configuration.
    max_tokens: 4096
    temperature: 0.3
