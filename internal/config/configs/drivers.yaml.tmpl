---
# drivers.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# This file defines drivers for external services.

drivers:
  ## Modify below to connect to your own redis server.
  # Below is only used when LOCALREDIS environment variable is not set.
  #
  redisqueue: &redis
    connection:
      Addr: localhost:6379
  redispubsub: *redis
  redislock: *redis
  api-broadcast: *redis
  redis-cache:
    connection:
      Addr: localhost:6379
      DB: "1"
  redis-scheduler:
    connection:
      Addr: localhost:6379
      DB: "2"

  ## Uncomment below to add kubernetes creds (sources).
  #
  # kubernetes:
  #   api_timeout: "30"
  #   sources:
  #     evergreen-k0s:
  #       Host: https://192.168.1.23:6443
  #       ClientCert: LOOKUP[vault,/secrets/data/hd-home/daemon#k0s_client_cert]
  #       ClientKey: LOOKUP[vault,/secrets/data/hd-home/daemon#k0s_client_key]
  #       CACert: LS0tLS1CRUdJTiBDRVJU...

  ## Uncomment below to add JWT token sources for web requests.
  #  Currently only github type is supported.
  # web:
  #   token_sources:
  #     hd_github_app:
  #       type: github
  #       app_id: "..."
  #       installation_id: "..."
  #       key: LOOKUP[vault,/secrets/data/hd-home/daemon#github_app_ssh_key]
  #       permissions: {}
  #     hdci_github_app:
  #       type: github
  #       app_id: "..."
  #       installation_id: "..."
  #       key: LOOKUP[vault,/secrets/data/hd-home/hdci#github_app_ssh_key]
  #       permissions: {}

  ## Uncomment below to setup API/UI auth through github login.
  #
  # auth-github:
    # GitHub OAuth Application credentials
    # These can be set via environment variables:
    # GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET
  #   client_id: LOOKUP[vault,/secrets/data/hd-home/daemon#github_client_id]
  #   client_secret: LOOKUP[vault,/secrets/data/hd-home/daemon#github_client_secret]
    
    # OAuth redirect URI - must match GitHub App configuration
  #   redirect_uri: '{% .env.UI_URL %}/auth/github/callback'

    # Require explicit allowlists when no allowed_users/allowed_orgs are configured.
  #   allow_when_no_restrictions: false
