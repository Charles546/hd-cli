# drivers.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# This file defines drivers for external services.

# Redis driver
redis:
  type: redis
{{- if eq .RedisMode "local" }}
  address: redis:6379
{{- else }}
  address: {{ .RedisConnString | quote }}
{{- end }}

# Web driver (HTTP server)
web:
  type: web
{{- if eq .DeploymentMode "docker" }}
  host: 0.0.0.0
  api_port: {{ .DockerAPIPort }}
  webhook_port: {{ .DockerWebhookPort }}
{{- else }}
  host: 0.0.0.0
  api_port: 9000
  webhook_port: 8080
{{- end }}

# GitHub driver
github:
  type: github
{{- if eq .GithubIntegrationType "github_app" }}
  app_id: {{ .GithubAppID | quote }}
  installation_id: {{ .GithubInstallationID | quote }}
  private_key: LOOKUP[vault, /secrets/data/{{ .ProjectName }}/githubPrivateKey]
{{- else }}
  token: LOOKUP[vault, /secrets/data/{{ .ProjectName }}/githubToken]
{{- end }}
  webhook_secret: LOOKUP[vault, /secrets/data/{{ .ProjectName }}/githubWebhookSecret]

{{- if .AIEnabled }}
# OpenAI-compatible AI driver
openai:
  type: openai
  api_key: LOOKUP[vault, /secrets/data/{{ .ProjectName }}/openaiApiKey]
  base_url: {{ .AIBaseURL | quote }}
  model: {{ .AIModel | quote }}
{{- end }}
