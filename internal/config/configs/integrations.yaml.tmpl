---
# integrations.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# This file defines system integrations for Honeydipper.
# Secrets are resolved via the configured secrets backend.

systems:
  # GitHub Integration
{{- if .HasGithubPATIntegration }}
  github:
    data:
      pat: LOOKUP[vault,/secrets/data/{{ .ProjectName }}/github#pat]
      token: $?nil # extra token for webhook validation, recommend using signature instead
{{- end }}
{{- if .HasGitHubAppIntegration }}
  github_app:
    # GitHub App authentication
    extends:
      - github
    data:
      pat: $?nil
      tokenSource: hd_github_app # use jwt defined in web driver
      signatureSecret: LOOKUP[vault,/secrets/data/{{ .ProjectName }}/github#webhookSecret]
      token: $?nil # extra token for webhook validation, recommend using signature instead
{{- end }}

  # Slack Integration
  slack_bot:
    data:
      token: LOOKUP[vault,/secrets/data/{{ .ProjectName }}/slack#botToken]
      interact_token: $?nil # used for webhook validation, recommend using signature instead
      slash_token: $?nil # used for webhook validation, recommend using signature instead
      signatureSecret: LOOKUP[vault,/secrets/data/{{ .ProjectName }}/slack#signingSecret]
