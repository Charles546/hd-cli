---
# integrations.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# This file defines system integrations for Honeydipper.
# Secrets are resolved via the configured secrets backend.

systems:
  # GitHub Integration
{{- if .HasGithubPATIntegration }}
  github:
    data:
      pat: {{ if .GithubTokenPath }}{{ if eq .SecretsBackend "dev" }}{{ .GithubTokenPath }}{{ else }}LOOKUP[vault,{{ .GithubTokenPath }}]{{ end }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/github#pat]{{ end }}
      token: $?nil # extra token for webhook validation, recommend using signature instead
{{- end }}
{{- if .HasGitHubAppIntegration }}
  github_app:
    # GitHub App authentication
    extends:
      - github
    data:
      pat: $?nil
      tokenSource: hd_github_app # use jwt defined in web driver
      signatureSecret: {{ if .GithubWebhookSecret }}{{ if eq .SecretsBackend "dev" }}{{ .GithubWebhookSecret }}{{ else }}LOOKUP[vault,{{ .GithubWebhookSecret }}]{{ end }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/github#webhookSecret]{{ end }}
      token: $?nil # extra token for webhook validation, recommend using signature instead
{{- end }}

  # Slack Integration
  slack_bot:
    data:
      token: {{ if .SlackBotTokenPath }}{{ if eq .SecretsBackend "dev" }}{{ .SlackBotTokenPath }}{{ else }}LOOKUP[vault,{{ .SlackBotTokenPath }}]{{ end }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/slack#botToken]{{ end }}
      interact_token: {{ if .SlackInteractionToken }}{{ if eq .SecretsBackend "dev" }}{{ .SlackInteractionToken }}{{ else }}LOOKUP[vault,{{ .SlackInteractionToken }}]{{ end }}{{ else }}$?nil{{ end }}
      slash_token: {{ if .SlackSlashCommandToken }}{{ if eq .SecretsBackend "dev" }}{{ .SlackSlashCommandToken }}{{ else }}LOOKUP[vault,{{ .SlackSlashCommandToken }}]{{ end }}{{ else }}$?nil{{ end }}
      signatureSecret: {{ if .SlackSigningSecretPath }}{{ if eq .SecretsBackend "dev" }}{{ .SlackSigningSecretPath }}{{ else }}LOOKUP[vault,{{ .SlackSigningSecretPath }}]{{ end }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/slack#signingSecret]{{ end }}
