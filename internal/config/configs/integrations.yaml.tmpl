# integrations.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# This file defines system integrations for Honeydipper.
# Secrets are resolved via the configured secrets backend.

systems:
  # GitHub Integration
  github:
    type: github
{{- if eq .GithubIntegrationType "github_app" }}
    # GitHub App authentication
    app_id: {{ .GithubAppID | quote }}
    installation_id: {{ .GithubInstallationID | quote }}
    private_key: LOOKUP[vault, /secrets/data/{{ .ProjectName }}/githubPrivateKey]
{{- else }}
    # PAT authentication
    token: LOOKUP[vault, /secrets/data/{{ .ProjectName }}/githubToken]
{{- end }}
    webhook_secret: LOOKUP[vault, /secrets/data/{{ .ProjectName }}/githubWebhookSecret]

  # Slack Integration
  slack:
    type: slack
    bot_token: LOOKUP[vault, /secrets/data/{{ .ProjectName }}/slackBotToken]
    signing_secret: LOOKUP[vault, /secrets/data/{{ .ProjectName }}/slackSigningSecret]
{{- if .SlackInteractionTokenPath }}
    interaction_token: LOOKUP[vault, /secrets/data/{{ .ProjectName }}/slackInteractionToken]
{{- end }}
{{- if .SlackSlashCommandTokenPath }}
    slash_command_token: LOOKUP[vault, /secrets/data/{{ .ProjectName }}/slackSlashCommandToken]
{{- end }}
