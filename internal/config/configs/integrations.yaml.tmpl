---
# integrations.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# This file defines system integrations for Honeydipper.
# Secrets are resolved via the configured secrets backend.

systems:
  # GitHub Integration
{{- if .HasGithubPATIntegration }}
  github:
    data:
      pat: {{ if .GithubTokenPath }}{{ if eq .SecretsBackend "dev" }}{{- if hasPrefix "$HD_" .GithubTokenPath }}{{ envRef (.GithubTokenPath | trimPrefix "$HD_") | quote }}{{- else }}{{ .GithubTokenPath }}{{ end }}{{ else }}LOOKUP[vault,{{ .GithubTokenPath }}]{{ end }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/github#pat]{{ end }}
      token: $?nil # extra token for webhook validation, recommend using signature instead
{{- end }}
{{- if .HasGitHubAppIntegration }}
  github_app:
    # GitHub App authentication
    extends:
      - github
    data:
      pat: $?nil
      tokenSource: hd_github_app # use jwt defined in web driver
      signatureSecret: {{ if .GithubWebhookSecret }}{{ if eq .SecretsBackend "dev" }}{{- if hasPrefix "$HD_" .GithubWebhookSecret }}{{ envRef (.GithubWebhookSecret | trimPrefix "$HD_") | quote }}{{- else }}{{ .GithubWebhookSecret }}{{ end }}{{ else }}LOOKUP[vault,{{ .GithubWebhookSecret }}]{{ end }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/github#webhookSecret]{{ end }}
      token: $?nil # extra token for webhook validation, recommend using signature instead
{{- end }}

  # Slack Integration
  slack_bot:
    data:
      token: {{ if .SlackBotTokenPath }}{{ if eq .SecretsBackend "dev" }}{{- if hasPrefix "$HD_" .SlackBotTokenPath }}{{ envRef (.SlackBotTokenPath | trimPrefix "$HD_") | quote }}{{- else }}{{ .SlackBotTokenPath }}{{ end }}{{ else }}LOOKUP[vault,{{ .SlackBotTokenPath }}]{{ end }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/slack#botToken]{{ end }}
      interact_token: {{ if .SlackInteractionToken }}{{ if eq .SecretsBackend "dev" }}{{- if hasPrefix "$HD_" .SlackInteractionToken }}{{ envRef (.SlackInteractionToken | trimPrefix "$HD_") | quote }}{{- else }}{{ .SlackInteractionToken }}{{ end }}{{ else }}LOOKUP[vault,{{ .SlackInteractionToken }}]{{ end }}{{ else }}$?nil{{ end }}
      slash_token: {{ if .SlackSlashCommandToken }}{{ if eq .SecretsBackend "dev" }}{{- if hasPrefix "$HD_" .SlackSlashCommandToken }}{{ envRef (.SlackSlashCommandToken | trimPrefix "$HD_") | quote }}{{- else }}{{ .SlackSlashCommandToken }}{{ end }}{{ else }}LOOKUP[vault,{{ .SlackSlashCommandToken }}]{{ end }}{{ else }}$?nil{{ end }}
      signatureSecret: {{ if .SlackSigningSecretPath }}{{ if eq .SecretsBackend "dev" }}{{- if hasPrefix "$HD_" .SlackSigningSecretPath }}{{ envRef (.SlackSigningSecretPath | trimPrefix "$HD_") | quote }}{{- else }}{{ .SlackSigningSecretPath }}{{ end }}{{ else }}LOOKUP[vault,{{ .SlackSigningSecretPath }}]{{ end }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/slack#signingSecret]{{ end }}
