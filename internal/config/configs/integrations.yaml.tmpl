---
# integrations.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# This file defines system integrations for Honeydipper.
# Secrets are resolved via the configured secrets backend.

systems:
  # GitHub Integration
{{- if .HasGithubPATIntegration }}
  github:
    data:
      pat: {{ if .GithubTokenPath }}{{ .GithubTokenPath | quote }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/github#pat]{{ end }}
      token: $?nil # extra token for webhook validation, recommend using signature instead
{{- end }}
{{- if .HasGitHubAppIntegration }}
  github_app:
    # GitHub App authentication
    extends:
      - github
    data:
      pat: $?nil
      tokenSource: hd_github_app # use jwt defined in web driver
      signatureSecret: {{ if .GithubWebhookSecret }}{{ .GithubWebhookSecret | quote }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/github#webhookSecret]{{ end }}
      token: $?nil # extra token for webhook validation, recommend using signature instead
{{- end }}

  # Slack Integration
  slack_bot:
    data:
      token: {{ if .SlackBotTokenPath }}{{ .SlackBotTokenPath | quote }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/slack#botToken]{{ end }}
      interact_token: {{ if .SlackInteractionToken }}{{ .SlackInteractionToken | quote }}{{ else }}$?nil{{ end }}
      slash_token: {{ if .SlackSlashCommandToken }}{{ .SlackSlashCommandToken | quote }}{{ else }}$?nil{{ end }}
      signatureSecret: {{ if .SlackSigningSecretPath }}{{ .SlackSigningSecretPath | quote }}{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/slack#signingSecret]{{ end }}
