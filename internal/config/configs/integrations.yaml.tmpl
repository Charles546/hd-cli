---
# integrations.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# This file defines system integrations for Honeydipper.
# Secrets are resolved via the configured secrets backend.

systems:
  # GitHub Integration
{{- if .HasGithubPATIntegration }}
  github:
    data:
      pat: {{ if .GithubTokenPath }}LOOKUP[vault,{{ .GithubTokenPath }}]{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/github#pat]{{ end }}
      token: $?nil # extra token for webhook validation, recommend using signature instead
{{- end }}
{{- if .HasGitHubAppIntegration }}
  github_app:
    # GitHub App authentication
    extends:
      - github
    data:
      pat: $?nil
      tokenSource: hd_github_app # use jwt defined in web driver
      signatureSecret: {{ if .GithubWebhookSecret }}LOOKUP[vault,{{ .GithubWebhookSecret }}]{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/github#webhookSecret]{{ end }}
      token: $?nil # extra token for webhook validation, recommend using signature instead
{{- end }}

  # Slack Integration
  slack_bot:
    data:
      token: {{ if .SlackBotTokenPath }}LOOKUP[vault,{{ .SlackBotTokenPath }}]{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/slack#botToken]{{ end }}
      interact_token: {{ if .SlackInteractionToken }}LOOKUP[vault,{{ .SlackInteractionToken }}]{{ else }}$?nil{{ end }}
      slash_token: {{ if .SlackSlashCommandToken }}LOOKUP[vault,{{ .SlackSlashCommandToken }}]{{ else }}$?nil{{ end }}
      signatureSecret: {{ if .SlackSigningSecretPath }}LOOKUP[vault,{{ .SlackSigningSecretPath }}]{{ else }}LOOKUP[vault,/secrets/data/{{ .ProjectName }}/slack#signingSecret]{{ end }}
