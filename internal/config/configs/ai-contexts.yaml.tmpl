---
# Honeydipper ai/contexts.yaml
# Generated by hd init for project: {{ .ProjectName }}
# Deployment mode: {{ .DeploymentMode }}

contexts:
  _agent_tool_call:
    ## configure below to allow your agent to run scripts in your k8s cluster.
    #
    run_script_k8s:
      run_script_k8s_image: charleshoney/agent-exec:latest
      run_script_k8s_system: k8s_default
      run_script_k8s_secret_driver_tag: 4.0.0-alpha4
      run_script_k8s_secret_driver: hd-driver-vault

      agent_script:
        identity:
          env:
            - name: GH_TOKEN
              value: hd-lookup:secrets/data/{{ .ProjectName }}/git#pat
            - name: VAULT_ADDR
              value: http://192.168.1.21:8200
            - name: VAULT_K8S_ROLE
              value: hdci-daemon
          volumes:
            - name: kube-api-access
              projected:
                sources:
                  - serviceAccountToken:
                      path: token
                      expirationSeconds: 3600
                      audience: vault
          volumeMounts:
            - name: kube-api-access
              mountPath: /var/run/secrets/kubernetes.io/serviceaccount
