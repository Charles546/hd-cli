# workflows.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# Defines basic notification and trigger workflows.

workflows:
  # Notify Slack on push events
  - name: notify-on-push
    triggers:
      - type: github
        event: push
    actions:
      - type: slack
        action: post
        channel: "#general"
        message: {{ printf "Push event received on branch %s%s%s" "{{ " "event.ref }}" " }}" | quote }}

  # Health check workflow
  - name: health-check
    triggers:
      - type: webhook
        path: /health
    actions:
      - type: builtin
        action: respond
        body:
          status: "ok"
          project: {{ .ProjectName | quote }}
