---
# Honeydipper init.yaml
# Generated by hd init for project: {{ .ProjectName }}
# Deployment mode: {{ .DeploymentMode }}

repos:
  - repo: {{ .EssentialsRepoURL | quote }}
    branch: {{ .EssentialsBranch | quote }}
{{- with .EssentialsPath }}
    path: {{ . | quote }}
{{- end }}
## by default the .EssentialCloneType should be public, meaning
#  no auth is needed for public repo
{{- if eq .EssentialsCloneType "ssh" }}
    key_file: {{ .EssentialsCloneKey | quote }}
{{- with .EssentialsCloneKeyPassEnv }}
    key_pass_env: {{ . | quote }}
{{- end }}
{{- else if eq .EssentialsCloneType "github_app" }}
    token_source: github
{{- else if eq .EssentialsCloneType "pat" }}
    pass_env: {{ .EssentialsClonePAT | default "DIPPER_GIT_PAT" | quote }}
{{- end }}
    options:
{{- if .AIEnabled }}
      ai: true
{{- end }}

includes:
{{- if .AIEnabled }}
  - "ai/*.yaml"
{{- end }}
  - "daemon.yaml"
  - "drivers.yaml"
  - "integrations.yaml"
  - "workflows.yaml"
