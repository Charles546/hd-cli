# Honeydipper init.yaml
# Generated by hd init for project: {{ .ProjectName }}
# Deployment mode: {{ .DeploymentMode }}

repos:
  - repo: {{ .EssentialsRepoURL | quote }}
    branch: {{ .EssentialsBranch | quote }}
    path: essentials
{{- if eq .BootstrapCloneCredentialType "github_app" }}
    token_source: github
{{- else if eq .BootstrapCloneCredentialType "pat" }}
    pass_env: {{ .BootstrapClonePassEnv | default "DIPPER_GIT_PASS" | quote }}
{{- end }}

includes:
  - "essentials/**/*.yaml"
  - "workflows.yaml"
  - "integrations.yaml"
  - "drivers.yaml"
  - "daemon.yaml"
{{- if .AIEnabled }}
  - "ai/**/*.yaml"
{{- end }}
