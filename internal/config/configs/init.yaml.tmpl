# Honeydipper init.yaml
# Generated by hd init for project: {{ .ProjectName }}
# Deployment mode: {{ .DeploymentMode }}

repo:
  - url: {{ .EssentialsRepoURL | quote }}
    branch: {{ .EssentialsBranch | quote }}
    path: essentials

include:
  - "essentials/**/*.yaml"
  - "workflows.yaml"
  - "integrations.yaml"
  - "drivers.yaml"
  - "daemon.yaml"
{{- if .AIEnabled }}
  - "ai/**/*.yaml"
{{- end }}
