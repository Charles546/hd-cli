# daemon.yaml
# Generated by hd init for project: {{ .ProjectName }}
#
# Daemon configuration for Honeydipper.

daemon:
  name: {{ .ProjectName | quote }}
  mode: {{ .DeploymentMode | quote }}

  # Logging
  logging:
    level: info
    format: json

  # Redis connection
  redis:
{{- if eq .RedisMode "local" }}
    address: redis:6379
{{- else }}
    address: {{ .RedisConnString | quote }}
{{- end }}

  # API server
  api:
{{- if eq .DeploymentMode "docker" }}
    host: 0.0.0.0
    port: {{ .DockerAPIPort }}
{{- else }}
    host: 0.0.0.0
    port: 9000
{{- end }}

  # Webhook receiver
  webhook:
{{- if eq .DeploymentMode "docker" }}
    host: 0.0.0.0
    port: {{ .DockerWebhookPort }}
{{- else }}
    host: 0.0.0.0
    port: 8080
{{- end }}

{{- if eq .DeploymentMode "docker" }}
  # Web UI
  ui:
    enabled: {{ .DockerEnableUI }}
{{- end }}

  # Secrets backend
{{- if eq .SecretsBackend "vault" }}
  secrets:
    driver: vault
    address: {{ .VaultAddress | quote }}
    auth_method: {{ .VaultAuthMethod | quote }}
{{- else }}
  secrets:
    driver: dev
{{- end }}
